{
  "name": "orbit-access",
  "version": "1.0.0",
  "description": "Team access control for GitHub & Notion — audit who has access, invite collaborators, manage permissions",
  "private": true,
  "main": "server.js",
  "author": "Orbit Access",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build:css": "node build-css.js",
    "build": "node build-css.js",
    "start": "node server.js",
    "stop": "fuser -k 3000/tcp 2>/dev/null || true",
    "restart": "npm run stop && node server.js"
  },
  "dependencies": {
    "animejs": "^4.5.0"
  }
}
